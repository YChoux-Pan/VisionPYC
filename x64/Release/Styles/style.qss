/* 1. 整体面板设置：去掉多余边框，让界面更现代 */
QTabWidget::pane {
    border: 1px solid #3a3a3a;
    background: #252526;
    top: -1px; /* 向上移动1像素，覆盖住TabBar底部的线条 */
}

/* 2. 标签栏整体样式 */
QTabBar {
    background: transparent;
}

/* 3. 单个 Tab 按钮的基础样式 (高度、宽度、默认颜色) */
QTabBar::tab {
    background: #2d2d2d;     /* 背景色 */
    color: #aaaaaa;          /* 文字颜色 */
    min-width: 100px;        /* 最小宽度 */
    height: 40px;            /* 按钮高度 */
    padding: 0px 15px;       /* 左右内边距 */
    margin-right: 2px;       /* 标签之间的间距 */
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    
    /* 关键：预留底部横线的位置，防止选中时抖动 */
    border-bottom: 3px solid transparent; 
}

/* 4. 鼠标悬停 (Hover) 状态 */
QTabBar::tab:hover {
    background: #3e3e42;
    color: #ffffff;
}

/* 5. 鼠标选中 (Selected) 状态：即当前点击选中的 Tab */
QTabBar::tab:selected {
    background: #323233;
    color: #00ff00;          /* 选中文字变绿 */
    font-weight: bold;
    
    /* 核心要求：在按钮下方搞个不同颜色的横线 */
    border-bottom: 3px solid #00ff00; 
}

/* 6. 非选中状态（可选，用于做区分） */
QTabBar::tab:!selected {
    margin-top: 2px; /* 让未选中的稍微矮一点点，增加层次感 */
}