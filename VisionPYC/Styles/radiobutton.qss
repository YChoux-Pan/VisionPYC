/* ????????? */
QRadioButton {
    color: white;
    font-size: 14px;
    spacing: 10px;
    background: transparent;
}

QRadioButton:hover {
    color: #AAAAAA; /* ?????? */
}

QRadioButton:checked {
    color: #00CC66; /* ??????? */
}

/* --- Indicator ????? --- */

/* ????????????????????? */
QRadioButton::indicator {
    /* ??????????????????????? */
}

/* 1. ??????????? (?10, ?8) */
QRadioButton::indicator:unchecked {
    width: 8px;   /* ?? */
    height: 8px;
    border: 1px solid white; /* ?? 1px???? = 8 + 1*2 = 10px */
    border-radius: 5px;      /* ?? 10 ???????? */
    background: transparent;
}

/* 2. ??? + ????????? (?10, ?4) */
/* ??????????????????????? */
QRadioButton::indicator:unchecked:hover {
    width: 4px;   /* ???? */
    height: 4px;
    border: 3px solid #004d40; /* ????? 3px???? = 4 + 3*2 = 10px */
    border-radius: 5px;        /* ??? 5px */
    background: transparent;
}

/* 3. ?????????? (?10, ?4) */
QRadioButton::indicator:checked {
    width: 4px;
    height: 4px;
    border: 3px solid #00CC66; /* ??????? = 4 + 3*2 = 10px */
    border-radius: 5px;
    background: transparent;
}

/* 4. ?? + ??/???????? (?10, ?4) */
QRadioButton::indicator:checked:hover,
QRadioButton::indicator:pressed {
    width: 4px;
    height: 4px;
    border: 3px solid #00FF7F; /* ?????? = 4 + 3*2 = 10px */
    border-radius: 5px;
    background: transparent;
}